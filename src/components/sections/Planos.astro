---
import Highlight from '../ui/Highlight.astro';
import Icon from '../ui/Icon.astro';
import { PLANS, UNITS, SITE, formatBRL, whatsappUrl } from '../../data/site';

const planMessage = (plan: string, unit: string) =>
  `Olá! Vim pelo site e tenho interesse no plano ${plan} da ${unit}.`;
---

<section class="section planos" id="planos" aria-labelledby="planos-title">
  <span class="ghost planos__ghost" aria-hidden="true" data-parallax="-0.15">Planos</span>

  <div class="container">
    <div class="planos__head">
      <div>
        <p class="eyebrow" data-reveal>Planos</p>
        <h2 class="display section-title" id="planos-title" data-reveal-title>
          <span class="thin">Escolha o plano</span><br />
          <span class="bold">e <Highlight>bora</Highlight> treinar</span>
        </h2>
      </div>

      <!-- Seletor de unidade: a pílula amarela acompanha o botão ativo (src/scripts/ui/plans.ts) -->
      <div class="switch" role="group" aria-label="Escolha a unidade" data-unit-switch>
        {
          UNITS.map((u, i) => (
            <button type="button" class="switch__btn" aria-pressed={i === 0 ? 'true' : 'false'} data-unit={u.id}>
              Unidade {u.short}
            </button>
          ))
        }
        <span class="switch__pill" aria-hidden="true" data-switch-pill></span>
      </div>
    </div>

    {
      UNITS.map((unit) => {
        const { featured, extras } = PLANS[unit.id];
        return (
          <div class="unit-plans" data-unit-panel={unit.id} aria-label={`Planos da ${unit.name}`} role="region">
            <p class="unit-plans__where">
              <Icon name="pin" /> {unit.name} · {unit.district}, {unit.city}
            </p>

            <ul class="planos__grid">
              {featured.map((plan) => (
                <li class:list={['plan', { 'plan--featured': plan.featured }]}>
                  <div class="plan__inner">
                    {plan.badge && <span class="plan__badge">{plan.badge}</span>}
                    <h3 class="plan__name">{plan.name}</h3>
                    <p class="plan__text">{plan.text}</p>

                    <p class="plan__from">a partir de</p>
                    <p class="plan__price">
                      <span class="plan__currency">R$</span>
                      <span class="plan__value">{formatBRL(plan.price)}</span>
                      <span class="plan__suffix">{plan.period}</span>
                    </p>

                    <ul class="plan__benefits">
                      {plan.includes.map((b) => (
                        <li>
                          <Icon name="check" /> {b}
                        </li>
                      ))}
                    </ul>

                    <a
                      href={whatsappUrl(planMessage(plan.name, unit.name), unit.whatsapp)}
                      class:list={['btn', 'plan__cta', { 'btn--dark': plan.featured }]}
                      target="_blank"
                      rel="noopener"
                      data-magnetic
                    >
                      <span class="btn__inner">
                        Quero esse <Icon name="arrow-up-right" />
                      </span>
                      <span class="sr-only"> plano ({plan.name}) — abre o WhatsApp da {unit.name}</span>
                    </a>
                  </div>
                </li>
              ))}
            </ul>

            <div class="extras">
              <h3 class="extras__title">Outras opções na {unit.name}</h3>
              <ul class="extras__list">
                {extras.map((x) => (
                  <li class="extras__item">
                    <span class="extras__name">
                      {x.name}
                      {x.note && <small> · {x.note}</small>}
                    </span>
                    <span class="extras__price">
                      R$ {formatBRL(x.price)}
                      <small>/{x.period}</small>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        );
      })
    }

    <div class="planos__foot">
      <a href={SITE.enrollUrl} class="btn" target="_blank" rel="noopener" data-magnetic>
        <span class="btn__inner">Fazer matrícula online <Icon name="arrow-up-right" /></span>
      </a>
      <p class="planos__note">
        Valores "a partir de", conforme o sistema de matrícula da academia. Confirme condições e formas de pagamento
        com a unidade.
      </p>
    </div>
  </div>
</section>

<style>
  .planos {
    overflow: hidden;
  }

  .planos__ghost {
    top: 2%;
    left: -4vw;
  }

  .planos__head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  /* ---------- Painel de cada unidade ---------- */

  .unit-plans {
    position: relative;
    z-index: 1;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .unit-plans[hidden] {
    display: none;
  }

  .unit-plans__where {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--sf-muted);
  }

  .unit-plans__where :global(.icon) {
    width: 18px;
    color: var(--sf-yellow);
  }

  /* ---------- Cards ---------- */

  .planos__grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .plan {
    position: relative;
    border-radius: var(--radius);
    padding: 1px;
    background: var(--sf-line);
    overflow: hidden;
    isolation: isolate;
  }

  .plan__inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: calc(var(--radius) - 1px);
    background: linear-gradient(170deg, var(--sf-card), var(--sf-surface));
  }

  /* Destaque: borda em gradiente girando (só transform) */
  .plan--featured {
    padding: 2px;
    background: var(--sf-yellow-deep);
  }

  .plan--featured::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 50%;
    width: 200%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: conic-gradient(from 0deg, transparent 0 55%, var(--sf-yellow-hot) 70%, #ffffff 76%, var(--sf-yellow-hot) 82%, transparent 95%);
    animation: plan-spin 4.5s linear infinite;
    animation-play-state: paused;
    will-change: transform;
  }

  /* Só gira enquanto o card está visível (classe aplicada em src/scripts/ui/plans.ts) */
  .plan--featured.is-inview::before {
    animation-play-state: running;
  }

  @keyframes plan-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plan--featured::before {
      animation: none;
    }
  }

  .plan--featured .plan__inner {
    border-radius: calc(var(--radius) - 2px);
    background:
      radial-gradient(90% 70% at 0% 0%, var(--sf-yellow-hot), transparent 65%),
      linear-gradient(170deg, var(--sf-yellow), #d9a900);
    color: var(--sf-on-accent);
  }

  .plan__badge {
    align-self: flex-start;
    margin-bottom: 1rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--sf-black);
    color: var(--sf-white);
    font-size: 0.6875rem;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .plan__name {
    font-size: clamp(1.4rem, 1.15rem + 0.9vw, 1.75rem);
    font-weight: 900;
    font-stretch: 112%;
    text-transform: uppercase;
    line-height: 1.05;
  }

  .plan__text {
    margin-top: 0.75rem;
    font-size: var(--fs-sm);
    color: var(--sf-muted);
  }

  .plan__from {
    margin-top: 1.75rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sf-muted);
  }

  .plan--featured .plan__text,
  .plan--featured .plan__from {
    color: rgba(11, 11, 12, 0.78);
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    margin-top: 0.2rem;
    font-stretch: 112%;
    white-space: nowrap;
  }

  .plan__currency {
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .plan__value {
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.5rem);
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .plan__suffix {
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .plan__benefits {
    display: grid;
    gap: 0.6rem;
    margin-block: 1.5rem 2rem;
    font-size: var(--fs-sm);
  }

  .plan__benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .plan__benefits :global(.icon) {
    width: 18px;
    flex: none;
    margin-top: 0.15em;
    color: var(--sf-yellow);
  }

  .plan--featured .plan__benefits :global(.icon) {
    color: var(--sf-on-accent);
  }

  .plan__cta {
    margin-top: auto;
    width: 100%;
  }

  /* ---------- Outras opções ---------- */

  .extras {
    margin-top: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius);
    background: var(--sf-surface);
    border: 1px solid var(--sf-line);
  }

  .extras__title {
    font-size: var(--fs-md);
    font-weight: 800;
    font-stretch: 112%;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .extras__list {
    display: grid;
    margin-top: 1rem;
  }

  .extras__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px dashed var(--sf-line);
    font-size: var(--fs-sm);
  }

  .extras__item:last-child {
    border-bottom: 0;
  }

  .extras__name small,
  .extras__price small {
    color: var(--sf-muted);
    font-size: 0.85em;
  }

  .extras__price {
    flex: none;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .planos__foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }

  .planos__note {
    flex: 1 1 280px;
    font-size: var(--fs-xs);
    color: var(--sf-muted);
  }

  @media (min-width: 768px) {
    .extras__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
    }
    .extras__item:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
  }

  @media (min-width: 1024px) {
    .planos__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
