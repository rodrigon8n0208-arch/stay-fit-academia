---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';
import { FEED, SITE } from '../../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/feed-*.jpg', { eager: true });
const img = (name: string) => files[`../../assets/img/${name}.jpg`].default;
---

<section class="section feed" aria-labelledby="feed-title">
  <div class="container">
    <div class="feed__head">
      <div>
        <p class="eyebrow" data-reveal>Instagram</p>
        <h2 class="display section-title" id="feed-title" data-reveal-title>
          <span class="thin">Acompanhe</span>
          <span class="bold">a resenha</span>
        </h2>
      </div>
      <a href={SITE.instagram.url} class="btn btn--ghost" target="_blank" rel="noopener" data-magnetic>
        <span class="btn__inner"><Icon name="instagram" /> Siga {SITE.instagram.handle}</span>
      </a>
    </div>

    <ul class="feed__grid" data-stagger>
      {
        FEED.map((post) => (
          <li data-stagger-item>
            <a href={post.url} class="feed__item" target="_blank" rel="noopener">
              <Image
                src={img(post.image)}
                alt={post.alt}
                widths={[240, 400, 600]}
                sizes="(min-width: 1024px) 16vw, (min-width: 768px) 31vw, 46vw"
                class="feed__img"
              />
              <span class="feed__overlay" aria-hidden="true">
                <Icon name="instagram" />
              </span>
              <span class="sr-only"> (abre no Instagram)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feed__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .feed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .feed__item {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16; /* capas de reels */
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--sf-card);
  }

  .feed__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .feed__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(242, 194, 0, 0.7);
    color: var(--sf-on-accent);
    opacity: 0;
    transition: opacity 0.35s;
  }

  .feed__overlay :global(.icon) {
    width: 40px;
    transform: scale(0.6) rotate(-13deg);
    transition: transform 0.5s var(--ease-out);
  }

  @media (hover: hover) {
    .feed__item:hover .feed__img {
      transform: scale(1.1);
    }
    .feed__item:hover .feed__overlay {
      opacity: 1;
    }
    .feed__item:hover .feed__overlay :global(.icon) {
      transform: scale(1) rotate(0);
    }
  }

  .feed__item:focus-visible .feed__overlay {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .feed__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .feed__grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
